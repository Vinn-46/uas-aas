{
    "name": "proyek/aas-shop",
    "description": "App Toko Online - Project AAS Kelompok Desil 10",
    "type": "project",
    "require": {
        "php": ">=8.5",
        "vlucas/phpdotenv": "^5.8",
        "dompdf/dompdf": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "secure-http": true,
        "optimize-autoloader": true,
        "sort-packages": true,
        "audit": {
            "abandoned": "fail",
            "block-insecure": true
        }
    }
}